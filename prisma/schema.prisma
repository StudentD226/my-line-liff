generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

// ------------------------------------------------------
// 1. ตั้งค่าระบบกลาง (System Configuration)
// ------------------------------------------------------
model SystemConfig {
  id                  Int         @id @default(1)
  projectType         ProjectType @default(HOUSING_ESTATE)
  flatRateAmount      Float       @default(500)   
  penaltyRatePerDay   Float       @default(100)   
  updatedAt           DateTime    @updatedAt      

  // 📅 การตั้งค่าวันที่และเวลาของระบบบิล
  invoiceGenerateDay  Int         @default(27)    
  invoiceGenerateTime String      @default("08:00") 
  dueDateDay          Int         @default(7)     
  penaltyStartDay     Int         @default(8)     
  secondReminderDay   Int         @default(15)    

  // 🏦 ข้อมูลบัญชีธนาคารรับเงินส่วนกลาง
  bankName            String      @default("ธนาคารกรุงไทย")
  bankAccountNo       String      @default("660-9-55290-8")
  bankAccountName     String      @default("นิติบุคคลหมู่บ้าน")
  bankLogoUrl         String      @default("/banks/KTB.png")
}

enum ProjectType {
  HOUSING_ESTATE 
  CONDO          
}

// ------------------------------------------------------
// 2. ข้อมูลผู้ใช้งาน และ สิทธิ์ (Users & Roles)
// ------------------------------------------------------
model User {
  id              String   @id @default(cuid())
  lineId          String?  @unique
  name            String?
  phone           String?
  role            Role     @default(USER)
  isNotify        Boolean  @default(true)
  
  residentHouseId String?
  residentHouse   House?   @relation("HouseResidents", fields: [residentHouseId], references: [id])
  ownedHouses     House[]  @relation("HouseOwner")
  
  createdAt       DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

// ------------------------------------------------------
// 3. ข้อมูลอสังหาริมทรัพย์ (Property Units)
// ------------------------------------------------------
model House {
  id        String   @id @default(cuid())
  houseNo   String   @unique
  houseSize Float    @default(0) 
  
  feeType   FeeType  @default(CALCULATED)
  feeRate   Float    @default(0) 
  
  ownerId   String?  
  owner     User?    @relation("HouseOwner", fields: [ownerId], references: [id])
  
  residents User[]   @relation("HouseResidents")
  
  invoices  Invoice[]
  reports   Report[]
  createdAt DateTime  @default(now())
}

enum FeeType {
  CALCULATED 
  FIXED      
}

// ------------------------------------------------------
// 4. ระบบการเงินและบิล (Financials & Invoices)
// ------------------------------------------------------
model Invoice {
  id              String        @id @default(cuid())
  invoiceNo       String        @unique
  billingMonth    Int           
  billingYear     Int           
  
  baseAmount      Float         
  penaltyAmount   Float         @default(0) 
  totalAmount     Float         
  
  paidAmount      Float         @default(0) 
  
  dueDate         DateTime      
  status          InvoiceStatus @default(PENDING)
  
  slipUrl         String?       
  payeeName       String?       
  
  // 🌟 ฟิลด์ใหม่สำหรับเก็บข้อมูลจาก AI ตรวจสลิป
  senderName      String?       // ชื่อผู้โอน
  receiverName    String?       // ชื่อผู้รับโอน
  bankRef         String?       // รหัสอ้างอิงธนาคาร
  
  transferDate    String?       
  transferTime    String?       
  paidAt          DateTime?     

  residentHouseId String
  house           House         @relation(fields: [residentHouseId], references: [id], onDelete: Cascade)
  
  scheduledSendAt DateTime?     
  isNotified      Boolean       @default(false) 

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum InvoiceStatus {
  PENDING   
  OVERDUE   
  CHECKING  
  PARTIAL   
  PAID      
  REJECTED  
}

// ------------------------------------------------------
// 5. ระบบแจ้งซ่อมและข่าวสาร (Utility & Communication)
// ------------------------------------------------------
model Report {
  id              String   @id @default(cuid())
  ticketNo        String   @unique  
  lineId          String   
  type            String   @default("REPAIR") 
  
  category        String   
  location        String   
  title           String   
  description     String   @db.Text 
  imageUrl        String?  
  
  status          String   @default("PENDING") 
  adminNote       String?  @db.Text 
  
  residentHouseId String
  house           House    @relation(fields: [residentHouseId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt 
}

// ------------------------------------------------------
// 6. ข่าวประกาศ (News)
// ------------------------------------------------------
model News {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text 
  imageUrl    String?
  
  category    String   @default("ทั่วไป")  // เช่น บำรุงรักษา, ด่วน, กิจกรรม, ทั่วไป
  status      String   @default("DRAFT")   // สถานะ: DRAFT (ร่าง), PUBLISHED (เผยแพร่), SCHEDULED (ตั้งเวลา)
  
  views       Int      @default(0)         // ยอดคนดู
  recipients  Int      @default(0)         // จำนวนลูกบ้านที่ส่ง LINE ไปถึง
  isPinned    Boolean  @default(false)     // ปักหมุดประกาศหรือไม่
  
  scheduledAt DateTime?                    // วันเวลาที่ต้องการให้เผยแพร่อัตโนมัติ (ถ้ามี)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt         
}

// ------------------------------------------------------
// 7. ระบบบัญชี รายรับ-รายจ่าย (Financial Tracking)
// ------------------------------------------------------
enum TransactionType {
  INCOME  
  EXPENSE 
}

model TransactionCategory {
  id          String   @id @default(cuid())
  name        String   
  type        TransactionType 
  isFavorite  Boolean  @default(false) 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions FinancialTransaction[]
}

model FinancialTransaction {
  id          String   @id @default(cuid())
  type        TransactionType 
  
  categoryId  String
  category    TransactionCategory @relation(fields: [categoryId], references: [id])
  
  description String?  
  amount      Float    
  date        DateTime 
  recordedBy  String?  

  receiptUrl  String?  
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------
// 8. ระบบแจ้งเตือนแอดมิน (Admin Reminders)
// ------------------------------------------------------
model AdminReminder {
  id          String   @id @default(cuid())
  title       String   
  dayOfMonth  Int      
  isActive    Boolean  @default(true) 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}